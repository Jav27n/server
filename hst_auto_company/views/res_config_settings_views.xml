<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_auto_company" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.auto.company</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']//block[@name='companies_setting_container']" position="inside">
                <setting
                    string="Auto-Select All Companies"
                    help="Automatically select all allowed companies when a user logs in">
                    <field name="auto_select_all_companies"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
